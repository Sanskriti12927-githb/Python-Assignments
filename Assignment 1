# Creating a list
A = ['Sanskriti', 'Aarav', 'Ananya', 'Rohan']
print(A)
# Adding an element in list
A = ['Sanskriti', 'Aarav', 'Ananya', 'Rohan']
A.append('Priya')
print(A)
# Removing an element from list
A = ['Sanskriti', 'Aarav', 'Ananya', 'Rohan']
A.remove('Aarav')
print(A)

# Creating a dictionary
X = {'Name': 'Sanskriti',
     'Course': 'CSE',
     'College': 'MIT WPU'}
print(X)
# To return list of all keys in dictionary
X = {'Name': 'Sanskriti',
     'Course': 'CSE',
     'College': 'MIT WPU'}
print(X.keys())
# To update the dictionary
X = {'Name': 'Sanskriti',
     'Course': 'CSE',
     'College': 'MIT WPU'}
X.update({'Area': 'Kothrud'})
print(X)

